generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Account {
  id        String   @id @default(auto()) @map("_id") @test.ObjectId
  name      String
  balance   Float
  strategies Strategy[]
}

model Strategy {
  id           String   @id @default(auto()) @map("_id") @test.ObjectId
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id])
  name         String
  mode         String
  leverage     Int
  openTrades   Trade[]
  closedTrades Trade[]
}

model Trade {
  id            String   @id @default(auto()) @map("_id") @test.ObjectId
  strategyId    String
  strategy      Strategy @relation(fields: [strategyId], references: [id])
  symbol        String
  isLong        Boolean
  entryPrice    Float
  exitPrice     Float?
  positionSize  Float
  pnl           Float?
  status        String   // "open", "closed", "partial"
  entryTime     DateTime
  exitTime      DateTime?
  sl            Float?
  tp            Float?
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id       Int       @id @default(autoincrement())
  userId   String    @unique
  balance  Float
  strategies Strategy[]
}

model Account {
  id        String   @id @default(auto()) @map("_id") @test.ObjectId
  name      String
  balance   Float
  strategies Strategy[]
}

model Strategy {
  id              Int       @id @default(autoincrement())
  strategyId      String
  strategyBalance Float      // Separate balance for the strategy
  initialBalance  Float
  userId          String
  user            User      @relation(fields: [userId], references: [userId])
  trades          Trade[]
}

model Trade {
  id          Int       @id @default(autoincrement())
  strategyId  String
  symbol      String
  isLong      Boolean
  entryPrice  Float
  positionSize Float
  status      String
  entryTime   DateTime
  stopLoss    Float?
  takeProfit  Float?
  exitPrice   Float?
  pnl         Float?
  exitTime    DateTime?
  strategy    Strategy  @relation(fields: [strategyId], references: [strategyId])
}
